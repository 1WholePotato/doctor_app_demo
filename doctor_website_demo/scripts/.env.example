# Seed-only settings for doctor_website_demo/.env.local or the shell environment.
# Use a disposable Supabase project. Shell values override .env.local.
VITE_SUPABASE_URL=https://your-disposable-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-disposable-project-service-role-key
# Must exactly match VITE_SUPABASE_URL. The seed refuses all requests otherwise.
SEED_CONFIRM_URL=https://your-disposable-project.supabase.co
# Optional future UTC date in YYYY-MM-DD format. Default is seven days from today.
# SEED_SESSION_DATE=2028-02-29
