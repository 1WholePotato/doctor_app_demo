# Secrets for the ozow-checkout Edge Function. Copy to supabase/functions/.env (ignored by git), fill in,
# then `supabase secrets set --env-file supabase/functions/.env` for the hosted project.
# Ozow One API base URL: https://stagingone.ozow.com/v1 for staging, https://one.ozow.com/v1 for production.
OZOW_API_URL=
# One API client from the Ozow Dashboard (One API > Clients) with the payments scope.
OZOW_CLIENT_ID=
OZOW_CLIENT_SECRET=
# Site code from the Ozow Dashboard (Sites), format XXX-XXX-XXX.
OZOW_SITE_CODE=
# Public origin of the web app. Ozow sends students back to $APP_URL/payments/return and refuses localhost.
APP_URL=
